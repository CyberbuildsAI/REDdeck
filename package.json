{
  "name": "edgedeck",
  "displayName": "EDGEdeck",
  "description": "A simple mod manager for Cyberpunk 2077: one list, add, on/off, deploy, remove.",
  "version": "0.27.0",
  "publisher": "edgemodders",
  "preview": true,
  "pricing": "Free",
  "license": "MIT",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#08090d",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Edgemodders/EDGEdeck"
  },
  "homepage": "https://edgemodders.github.io/EDGEdeck/",
  "bugs": {
    "url": "https://github.com/Edgemodders/EDGEdeck/issues"
  },
  "engines": {
    "vscode": "^1.80.0",
    "node": ">=20"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "cyberpunk",
    "modding",
    "mod manager",
    "redcode",
    "nexus"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "edgedeck",
          "title": "EDGEdeck",
          "icon": "images/activity.svg"
        }
      ]
    },
    "views": {
      "edgedeck": [
        {
          "id": "edgedeck.mods",
          "name": "Mods"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "edgedeck.mods",
        "contents": "No mods yet.\nAdd a zip from Nexus Mods or a mod folder, turn it on, and deploy. Nothing touches the game until you deploy.\n[Add mod](command:edgedeck.addMod)",
        "when": "edgedeck.empty"
      },
      {
        "view": "edgedeck.mods",
        "contents": "The game was not found through Steam, GOG or Epic.\n[Find the game folder](command:edgedeck.pickGame)",
        "when": "edgedeck.empty && edgedeck.setup.game"
      },
      {
        "view": "edgedeck.mods",
        "contents": "Vortex has mods for this game. EDGEdeck can take copies of them; Vortex is left alone.\n[Import from Vortex](command:edgedeck.importVortex)",
        "when": "edgedeck.empty && edgedeck.setup.vortex"
      },
      {
        "view": "edgedeck.mods",
        "contents": "Sign in to Nexus Mods for updates and downloads from the site.\n[Sign in to Nexus](command:edgedeck.nexusSignIn)",
        "when": "edgedeck.empty && edgedeck.setup.nexus"
      },
      {
        "view": "edgedeck.mods",
        "contents": "Nexus Mods' Mod manager download buttons go to another program now. EDGEdeck can take them over.\n[Handle download links](command:edgedeck.nexusHandleLinks)",
        "when": "edgedeck.empty && edgedeck.setup.links"
      },
      {
        "view": "edgedeck.mods",
        "contents": "REDbridge sees conflicts inside archives. It is a 70 MB download that EDGEdeck installs for you.\n[Get REDbridge](command:edgedeck.getBridge)",
        "when": "edgedeck.empty && edgedeck.setup.bridge"
      }
    ],
    "commands": [
      {
        "command": "edgedeck.suggestTheme",
        "title": "Suggest the HUD theme",
        "category": "EDGEdeck"
      },
      {
        "command": "edgedeck.openPage",
        "title": "Open EDGEdeck",
        "category": "EDGEdeck",
        "icon": "$(table)"
      },
      {
        "command": "edgedeck.addMod",
        "title": "Add mod",
        "category": "EDGEdeck",
        "icon": "$(add)"
      },
      {
        "command": "edgedeck.details",
        "title": "Details",
        "category": "EDGEdeck"
      },
      {
        "command": "edgedeck.addProject",
        "title": "Add from REDcode project",
        "category": "EDGEdeck"
      },
      {
        "command": "edgedeck.checkConflicts",
        "title": "Show conflicts",
        "category": "EDGEdeck",
        "icon": "$(warning)"
      },
      {
        "command": "edgedeck.importVortex",
        "title": "Import from Vortex",
        "category": "EDGEdeck"
      },
      {
        "command": "edgedeck.deploy",
        "title": "Deploy",
        "category": "EDGEdeck",
        "icon": "$(rocket)"
      },
      {
        "command": "edgedeck.undo",
        "title": "Undo deploy",
        "category": "EDGEdeck"
      },
      {
        "command": "edgedeck.remove",
        "title": "Remove",
        "category": "EDGEdeck"
      },
      {
        "command": "edgedeck.moveUp",
        "title": "Move up (wins conflicts)",
        "category": "EDGEdeck",
        "icon": "$(arrow-up)"
      },
      {
        "command": "edgedeck.moveDown",
        "title": "Move down",
        "category": "EDGEdeck",
        "icon": "$(arrow-down)"
      },
      {
        "command": "edgedeck.openInExplorer",
        "title": "Reveal in File Explorer",
        "category": "EDGEdeck"
      },
      {
        "command": "edgedeck.revealInGame",
        "title": "Reveal in Game Folder",
        "category": "EDGEdeck"
      },
      {
        "command": "edgedeck.openLibrary",
        "title": "Open library folder",
        "category": "EDGEdeck"
      },
      {
        "command": "edgedeck.refresh",
        "title": "Refresh",
        "category": "EDGEdeck",
        "icon": "$(refresh)"
      },
      {
        "command": "edgedeck.showLog",
        "title": "Show log",
        "category": "EDGEdeck"
      },
      {
        "command": "edgedeck.nexusSignIn",
        "title": "Nexus: sign in",
        "category": "EDGEdeck",
        "icon": "$(sign-in)"
      },
      {
        "command": "edgedeck.nexusSignOut",
        "title": "Nexus: sign out",
        "category": "EDGEdeck"
      },
      {
        "command": "edgedeck.nexusSetKey",
        "title": "Nexus: set API key (paste, instead of signing in)",
        "category": "EDGEdeck"
      },
      {
        "command": "edgedeck.nexusOpen",
        "title": "Open on Nexus Mods",
        "category": "EDGEdeck"
      },
      {
        "command": "edgedeck.checkUpdates",
        "title": "Nexus: check for updates",
        "category": "EDGEdeck",
        "icon": "$(cloud-download)"
      },
      {
        "command": "edgedeck.nexusAddLink",
        "title": "Nexus: add from a link",
        "category": "EDGEdeck"
      },
      {
        "command": "edgedeck.nexusHandleLinks",
        "title": "Nexus: handle download links (nxm)",
        "category": "EDGEdeck"
      },
      {
        "command": "edgedeck.nexusReleaseLinks",
        "title": "Nexus: stop handling download links",
        "category": "EDGEdeck"
      },
      {
        "command": "edgedeck.saveLoadout",
        "title": "Save as new loadout...",
        "category": "EDGEdeck"
      },
      {
        "command": "edgedeck.loadLoadout",
        "title": "Switch loadout...",
        "category": "EDGEdeck",
        "icon": "$(versions)"
      },
      {
        "command": "edgedeck.exportLoadout",
        "title": "Export the active loadout...",
        "category": "EDGEdeck"
      },
      {
        "command": "edgedeck.importLoadout",
        "title": "Import a loadout...",
        "category": "EDGEdeck"
      },
      {
        "command": "edgedeck.switchVersion",
        "title": "Switch version...",
        "category": "EDGEdeck"
      },
      {
        "command": "edgedeck.showChanges",
        "title": "Show pending changes",
        "category": "EDGEdeck"
      },
      {
        "command": "edgedeck.getBridge",
        "title": "Get REDbridge",
        "category": "EDGEdeck"
      },
      {
        "command": "edgedeck.pickGame",
        "title": "Pick the game folder...",
        "category": "EDGEdeck"
      },
      {
        "command": "edgedeck.setup",
        "title": "EDGEdeck: Set up...",
        "category": "EDGEdeck"
      },
      {
        "command": "edgedeck.hideSetupStep",
        "title": "Not now",
        "icon": "$(close)"
      },
      {
        "command": "edgedeck.mcpSetup",
        "title": "EDGEdeck: Connect an assistant (MCP)...",
        "category": "EDGEdeck"
      },
      {
        "command": "edgedeck.updateBridge",
        "title": "Update REDbridge",
        "category": "EDGEdeck"
      },
      {
        "command": "edgedeck.addToProject",
        "title": "Add to Project",
        "category": "EDGEdeck"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "edgedeck.openPage",
          "when": "view == edgedeck.mods",
          "group": "navigation@0"
        },
        {
          "command": "edgedeck.addMod",
          "when": "view == edgedeck.mods",
          "group": "navigation@1"
        },
        {
          "command": "edgedeck.deploy",
          "when": "view == edgedeck.mods",
          "group": "navigation@2"
        },
        {
          "command": "edgedeck.refresh",
          "when": "view == edgedeck.mods",
          "group": "navigation@4"
        },
        {
          "command": "edgedeck.checkUpdates",
          "when": "view == edgedeck.mods",
          "group": "navigation@3"
        },
        {
          "command": "edgedeck.checkConflicts",
          "when": "view == edgedeck.mods",
          "group": "1_more@0"
        },
        {
          "command": "edgedeck.showChanges",
          "when": "view == edgedeck.mods",
          "group": "1_more@0"
        },
        {
          "command": "edgedeck.importVortex",
          "when": "view == edgedeck.mods",
          "group": "1_more@1"
        },
        {
          "command": "edgedeck.undo",
          "when": "view == edgedeck.mods && edgedeck.deployed",
          "group": "1_more@2"
        },
        {
          "command": "edgedeck.openLibrary",
          "when": "view == edgedeck.mods",
          "group": "2_folders@1"
        },
        {
          "command": "edgedeck.showLog",
          "when": "view == edgedeck.mods",
          "group": "2_folders@2"
        },
        {
          "command": "edgedeck.nexusSignIn",
          "when": "view == edgedeck.mods",
          "group": "1_more@0"
        },
        {
          "command": "edgedeck.nexusAddLink",
          "when": "view == edgedeck.mods",
          "group": "1_more@3"
        },
        {
          "command": "edgedeck.addProject",
          "when": "view == edgedeck.mods",
          "group": "1_more@4"
        },
        {
          "command": "edgedeck.saveLoadout",
          "when": "view == edgedeck.mods",
          "group": "3_loadouts@1"
        },
        {
          "command": "edgedeck.exportLoadout",
          "when": "view == edgedeck.mods",
          "group": "3_loadouts@3"
        },
        {
          "command": "edgedeck.importLoadout",
          "when": "view == edgedeck.mods",
          "group": "3_loadouts@4"
        },
        {
          "command": "edgedeck.loadLoadout",
          "when": "view == edgedeck.mods",
          "group": "3_loadouts@0"
        },
        {
          "command": "edgedeck.getBridge",
          "when": "view == edgedeck.mods",
          "group": "2_folders@0"
        },
        {
          "command": "edgedeck.pickGame",
          "when": "view == edgedeck.mods",
          "group": "2_folders@3"
        },
        {
          "command": "edgedeck.loadLoadout",
          "when": "view == edgedeck.mods",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "edgedeck.hideSetupStep",
          "when": "view == edgedeck.mods && viewItem == setup",
          "group": "inline"
        },
        {
          "command": "edgedeck.moveUp",
          "when": "view == edgedeck.mods && viewItem == mod",
          "group": "inline@1"
        },
        {
          "command": "edgedeck.moveDown",
          "when": "view == edgedeck.mods && viewItem == mod",
          "group": "inline@2"
        },
        {
          "command": "edgedeck.details",
          "when": "view == edgedeck.mods && viewItem == mod",
          "group": "0_details@1"
        },
        {
          "command": "edgedeck.nexusOpen",
          "when": "view == edgedeck.mods && viewItem == mod",
          "group": "1_open@0"
        },
        {
          "command": "edgedeck.openInExplorer",
          "when": "view == edgedeck.mods && viewItem == mod",
          "group": "1_open@1"
        },
        {
          "command": "edgedeck.revealInGame",
          "when": "view == edgedeck.mods && viewItem =~ /^(mod|folder|file)$/",
          "group": "1_open@1"
        },
        {
          "command": "edgedeck.remove",
          "when": "view == edgedeck.mods && viewItem == mod",
          "group": "9_remove@1"
        },
        {
          "command": "edgedeck.switchVersion",
          "when": "view == edgedeck.mods && viewItem == mod",
          "group": "inline@9"
        },
        {
          "command": "edgedeck.addToProject",
          "when": "view == edgedeck.mods && viewItem == mod && edgedeck.projectOpen",
          "group": "1_open@2"
        },
        {
          "command": "edgedeck.addToProject",
          "when": "view == edgedeck.mods && viewItem == folder && edgedeck.projectOpen",
          "group": "1_open@2"
        },
        {
          "command": "edgedeck.addToProject",
          "when": "view == edgedeck.mods && viewItem == file && edgedeck.projectOpen",
          "group": "1_open@2"
        }
      ],
      "commandPalette": [
        {
          "command": "edgedeck.remove",
          "when": "false"
        },
        {
          "command": "edgedeck.moveUp",
          "when": "false"
        },
        {
          "command": "edgedeck.moveDown",
          "when": "false"
        },
        {
          "command": "edgedeck.openInExplorer",
          "when": "false"
        },
        {
          "command": "edgedeck.revealInGame",
          "when": "false"
        },
        {
          "command": "edgedeck.details",
          "when": "false"
        },
        {
          "command": "edgedeck.nexusOpen",
          "when": "false"
        },
        {
          "command": "edgedeck.hideSetupStep",
          "when": "false"
        },
        {
          "command": "edgedeck.addToProject",
          "when": "false"
        }
      ],
      "explorer/context": [
        {
          "command": "edgedeck.addProject",
          "when": "resourceExtname == .cpmodproj",
          "group": "edgedeck@1"
        }
      ]
    },
    "configuration": {
      "title": "EDGEdeck",
      "properties": {
        "edgedeck.gamePath": {
          "type": "string",
          "default": "",
          "description": "The Cyberpunk 2077 install folder (the one containing bin, archive and r6). Leave it empty to find the game through Steam, GOG or Epic on every start; the status bar and the EDGEdeck page footer show the folder in use. Set it only for a game those cannot see. The command EDGEdeck: Pick the game folder sets it for you."
        },
        "edgedeck.libraryPath": {
          "type": "string",
          "default": "",
          "description": "Where EDGEdeck keeps your mods. Empty means %USERPROFILE%\\EDGEdeck. Put it on the same drive as the game so deploy can use hardlinks instead of copies."
        },
        "edgedeck.bridgePath": {
          "type": "string",
          "default": "",
          "description": "Path to REDbridge.exe or its folder. Empty means the copy EDGEdeck fetched with Get REDbridge, else a REDbridge checkout next to this one, else REDbridge on PATH. With it, EDGEdeck shows conflicts between resources inside mod archives."
        },
        "edgedeck.dotnetRoot": {
          "type": "string",
          "default": "",
          "description": "DOTNET_ROOT for the REDbridge process only. Empty means the per-user .NET 10 runtime in %LOCALAPPDATA%\\Microsoft\\dotnet when there is one, else whatever the machine has. Never set DOTNET_ROOT as a user environment variable: every .NET program then looks only there."
        },
        "edgedeck.nexusCheckUpdatesOnStart": {
          "type": "boolean",
          "default": true,
          "description": "Ask Nexus Mods once a day whether the mods with a Nexus id have a newer file. Needs you signed in (EDGEdeck: Nexus: sign in)."
        },
        "edgedeck.nexusClientId": {
          "type": "string",
          "default": "",
          "description": "The OAuth client id Nexus Mods assigned to EDGEdeck. With it, Nexus: sign in opens the Nexus sign-in page in your browser and comes back on its own; the sign-in renews itself. Empty means the application slug below, or the API Access page and a pasted key."
        },
        "edgedeck.nexusApplication": {
          "type": "string",
          "default": "",
          "description": "The application slug Nexus Mods registered for EDGEdeck's older single sign-on. Used when there is no client id. Empty means sign-in opens the API Access page and asks you to paste the key."
        },
        "edgedeck.vortexStagingPath": {
          "type": "string",
          "default": "",
          "description": "Where Vortex keeps its Cyberpunk 2077 mods (Vortex: Settings > Mods > Mod Staging Folder), for Import from Vortex. Empty means EDGEdeck looks in Vortex's deployment manifest, Vortex's default folder in AppData, and \"Vortex Mods\\cyberpunk2077\" on each drive, and asks when none has mods."
        }
      }
    },
    "colors": [
      {
        "id": "edgedeck.accent",
        "description": "Accent for EDGEdeck icons and the status bar item.",
        "defaults": {
          "dark": "#fcee0a",
          "light": "#8a7a00",
          "highContrast": "#fcee0a",
          "highContrastLight": "#8a7a00"
        }
      }
    ],
    "mcpServerDefinitionProviders": [
      {
        "id": "edgedeck.mcp",
        "label": "EDGEdeck"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "package": "node -e \"require('fs').mkdirSync('dist',{recursive:true})\" && vsce package --no-dependencies --target win32-x64 --readme-path docs/marketplace.md --out dist/",
    "test:ui": "node scripts/ui-test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "7zip-bin": "^5.2.0",
    "vscode-jsonrpc": "^9.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/vscode": "1.80.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "ovsx": "^1.2.0",
    "typescript": "~5.9.3"
  },
  "bin": {
    "edgedeck": "bin/edgedeck.mjs"
  }
}
