{
  "name": "reddeck",
  "displayName": "REDdeck",
  "description": "A simple mod manager for Cyberpunk 2077: one list, add, on/off, deploy, remove.",
  "version": "0.25.2",
  "publisher": "edgemodders",
  "preview": true,
  "pricing": "Free",
  "license": "MIT",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#08090d",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Edgemodders/REDdeck"
  },
  "engines": {
    "vscode": "^1.80.0",
    "node": ">=20"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "cyberpunk",
    "modding",
    "mod manager",
    "redcode",
    "nexus"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "reddeck",
          "title": "REDdeck",
          "icon": "images/activity.svg"
        }
      ]
    },
    "views": {
      "reddeck": [
        {
          "id": "reddeck.mods",
          "name": "Mods"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "reddeck.mods",
        "contents": "No mods yet.\nAdd a zip from Nexus Mods or a mod folder, turn it on, and deploy. Nothing touches the game until you deploy.\n[Add mod](command:reddeck.addMod)",
        "when": "reddeck.empty"
      },
      {
        "view": "reddeck.mods",
        "contents": "The game was not found through Steam, GOG or Epic.\n[Find the game folder](command:reddeck.pickGame)",
        "when": "reddeck.empty && reddeck.setup.game"
      },
      {
        "view": "reddeck.mods",
        "contents": "Vortex has mods for this game. REDdeck can take copies of them; Vortex is left alone.\n[Import from Vortex](command:reddeck.importVortex)",
        "when": "reddeck.empty && reddeck.setup.vortex"
      },
      {
        "view": "reddeck.mods",
        "contents": "Sign in to Nexus Mods for updates and downloads from the site.\n[Sign in to Nexus](command:reddeck.nexusSignIn)",
        "when": "reddeck.empty && reddeck.setup.nexus"
      },
      {
        "view": "reddeck.mods",
        "contents": "REDbridge sees conflicts inside archives. It is a 70 MB download that REDdeck installs for you.\n[Get REDbridge](command:reddeck.getBridge)",
        "when": "reddeck.empty && reddeck.setup.bridge"
      }
    ],
    "commands": [
      {
        "command": "reddeck.suggestTheme",
        "title": "Suggest the HUD theme",
        "category": "REDdeck"
      },
      {
        "command": "reddeck.openPage",
        "title": "Open REDdeck",
        "category": "REDdeck",
        "icon": "$(table)"
      },
      {
        "command": "reddeck.addMod",
        "title": "Add mod",
        "category": "REDdeck",
        "icon": "$(add)"
      },
      {
        "command": "reddeck.details",
        "title": "Details",
        "category": "REDdeck"
      },
      {
        "command": "reddeck.addProject",
        "title": "Add from REDcode project",
        "category": "REDdeck"
      },
      {
        "command": "reddeck.checkConflicts",
        "title": "Show conflicts",
        "category": "REDdeck",
        "icon": "$(warning)"
      },
      {
        "command": "reddeck.importVortex",
        "title": "Import from Vortex",
        "category": "REDdeck"
      },
      {
        "command": "reddeck.deploy",
        "title": "Deploy",
        "category": "REDdeck",
        "icon": "$(rocket)"
      },
      {
        "command": "reddeck.undo",
        "title": "Undo deploy",
        "category": "REDdeck"
      },
      {
        "command": "reddeck.remove",
        "title": "Remove",
        "category": "REDdeck"
      },
      {
        "command": "reddeck.moveUp",
        "title": "Move up (wins conflicts)",
        "category": "REDdeck",
        "icon": "$(arrow-up)"
      },
      {
        "command": "reddeck.moveDown",
        "title": "Move down",
        "category": "REDdeck",
        "icon": "$(arrow-down)"
      },
      {
        "command": "reddeck.openInExplorer",
        "title": "Reveal in File Explorer",
        "category": "REDdeck"
      },
      {
        "command": "reddeck.revealInGame",
        "title": "Reveal in Game Folder",
        "category": "REDdeck"
      },
      {
        "command": "reddeck.openLibrary",
        "title": "Open library folder",
        "category": "REDdeck"
      },
      {
        "command": "reddeck.refresh",
        "title": "Refresh",
        "category": "REDdeck",
        "icon": "$(refresh)"
      },
      {
        "command": "reddeck.showLog",
        "title": "Show log",
        "category": "REDdeck"
      },
      {
        "command": "reddeck.nexusSignIn",
        "title": "Nexus: sign in",
        "category": "REDdeck",
        "icon": "$(sign-in)"
      },
      {
        "command": "reddeck.nexusSignOut",
        "title": "Nexus: sign out",
        "category": "REDdeck"
      },
      {
        "command": "reddeck.nexusSetKey",
        "title": "Nexus: set API key (paste, instead of signing in)",
        "category": "REDdeck"
      },
      {
        "command": "reddeck.nexusOpen",
        "title": "Open on Nexus Mods",
        "category": "REDdeck"
      },
      {
        "command": "reddeck.checkUpdates",
        "title": "Nexus: check for updates",
        "category": "REDdeck",
        "icon": "$(cloud-download)"
      },
      {
        "command": "reddeck.nexusAddLink",
        "title": "Nexus: add from a link",
        "category": "REDdeck"
      },
      {
        "command": "reddeck.nexusHandleLinks",
        "title": "Nexus: handle download links (nxm)",
        "category": "REDdeck"
      },
      {
        "command": "reddeck.nexusReleaseLinks",
        "title": "Nexus: stop handling download links",
        "category": "REDdeck"
      },
      {
        "command": "reddeck.saveLoadout",
        "title": "Save loadout",
        "category": "REDdeck"
      },
      {
        "command": "reddeck.loadLoadout",
        "title": "Load loadout",
        "category": "REDdeck"
      },
      {
        "command": "reddeck.switchVersion",
        "title": "Switch version...",
        "category": "REDdeck"
      },
      {
        "command": "reddeck.showChanges",
        "title": "Show pending changes",
        "category": "REDdeck"
      },
      {
        "command": "reddeck.getBridge",
        "title": "Get REDbridge",
        "category": "REDdeck"
      },
      {
        "command": "reddeck.pickGame",
        "title": "Pick the game folder...",
        "category": "REDdeck"
      },
      {
        "command": "reddeck.setup",
        "title": "REDdeck: Set up...",
        "category": "REDdeck"
      },
      {
        "command": "reddeck.hideSetupStep",
        "title": "Not now",
        "icon": "$(close)"
      },
      {
        "command": "reddeck.mcpSetup",
        "title": "REDdeck: Connect an assistant (MCP)...",
        "category": "REDdeck"
      },
      {
        "command": "reddeck.updateBridge",
        "title": "Update REDbridge",
        "category": "REDdeck"
      },
      {
        "command": "reddeck.addToProject",
        "title": "Add to Project",
        "category": "REDdeck"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "reddeck.openPage",
          "when": "view == reddeck.mods",
          "group": "navigation@0"
        },
        {
          "command": "reddeck.addMod",
          "when": "view == reddeck.mods",
          "group": "navigation@1"
        },
        {
          "command": "reddeck.deploy",
          "when": "view == reddeck.mods",
          "group": "navigation@2"
        },
        {
          "command": "reddeck.refresh",
          "when": "view == reddeck.mods",
          "group": "navigation@4"
        },
        {
          "command": "reddeck.checkUpdates",
          "when": "view == reddeck.mods",
          "group": "navigation@3"
        },
        {
          "command": "reddeck.checkConflicts",
          "when": "view == reddeck.mods",
          "group": "1_more@0"
        },
        {
          "command": "reddeck.showChanges",
          "when": "view == reddeck.mods",
          "group": "1_more@0"
        },
        {
          "command": "reddeck.importVortex",
          "when": "view == reddeck.mods",
          "group": "1_more@1"
        },
        {
          "command": "reddeck.undo",
          "when": "view == reddeck.mods && reddeck.deployed",
          "group": "1_more@2"
        },
        {
          "command": "reddeck.openLibrary",
          "when": "view == reddeck.mods",
          "group": "2_folders@1"
        },
        {
          "command": "reddeck.showLog",
          "when": "view == reddeck.mods",
          "group": "2_folders@2"
        },
        {
          "command": "reddeck.nexusSignIn",
          "when": "view == reddeck.mods",
          "group": "1_more@0"
        },
        {
          "command": "reddeck.nexusAddLink",
          "when": "view == reddeck.mods",
          "group": "1_more@3"
        },
        {
          "command": "reddeck.addProject",
          "when": "view == reddeck.mods",
          "group": "1_more@4"
        },
        {
          "command": "reddeck.saveLoadout",
          "when": "view == reddeck.mods",
          "group": "3_loadouts@1"
        },
        {
          "command": "reddeck.loadLoadout",
          "when": "view == reddeck.mods",
          "group": "3_loadouts@2"
        },
        {
          "command": "reddeck.getBridge",
          "when": "view == reddeck.mods",
          "group": "2_folders@0"
        },
        {
          "command": "reddeck.pickGame",
          "when": "view == reddeck.mods",
          "group": "2_folders@3"
        }
      ],
      "view/item/context": [
        {
          "command": "reddeck.hideSetupStep",
          "when": "view == reddeck.mods && viewItem == setup",
          "group": "inline"
        },
        {
          "command": "reddeck.moveUp",
          "when": "view == reddeck.mods && viewItem == mod",
          "group": "inline@1"
        },
        {
          "command": "reddeck.moveDown",
          "when": "view == reddeck.mods && viewItem == mod",
          "group": "inline@2"
        },
        {
          "command": "reddeck.details",
          "when": "view == reddeck.mods && viewItem == mod",
          "group": "0_details@1"
        },
        {
          "command": "reddeck.nexusOpen",
          "when": "view == reddeck.mods && viewItem == mod",
          "group": "1_open@0"
        },
        {
          "command": "reddeck.openInExplorer",
          "when": "view == reddeck.mods && viewItem == mod",
          "group": "1_open@1"
        },
        {
          "command": "reddeck.revealInGame",
          "when": "view == reddeck.mods && viewItem =~ /^(mod|folder|file)$/",
          "group": "1_open@1"
        },
        {
          "command": "reddeck.remove",
          "when": "view == reddeck.mods && viewItem == mod",
          "group": "9_remove@1"
        },
        {
          "command": "reddeck.switchVersion",
          "when": "view == reddeck.mods && viewItem == mod",
          "group": "inline@9"
        },
        {
          "command": "reddeck.addToProject",
          "when": "view == reddeck.mods && viewItem == mod && reddeck.projectOpen",
          "group": "1_open@2"
        },
        {
          "command": "reddeck.addToProject",
          "when": "view == reddeck.mods && viewItem == folder && reddeck.projectOpen",
          "group": "1_open@2"
        },
        {
          "command": "reddeck.addToProject",
          "when": "view == reddeck.mods && viewItem == file && reddeck.projectOpen",
          "group": "1_open@2"
        }
      ],
      "commandPalette": [
        {
          "command": "reddeck.remove",
          "when": "false"
        },
        {
          "command": "reddeck.moveUp",
          "when": "false"
        },
        {
          "command": "reddeck.moveDown",
          "when": "false"
        },
        {
          "command": "reddeck.openInExplorer",
          "when": "false"
        },
        {
          "command": "reddeck.revealInGame",
          "when": "false"
        },
        {
          "command": "reddeck.details",
          "when": "false"
        },
        {
          "command": "reddeck.nexusOpen",
          "when": "false"
        },
        {
          "command": "reddeck.hideSetupStep",
          "when": "false"
        },
        {
          "command": "reddeck.addToProject",
          "when": "false"
        }
      ],
      "explorer/context": [
        {
          "command": "reddeck.addProject",
          "when": "resourceExtname == .cpmodproj",
          "group": "reddeck@1"
        }
      ]
    },
    "configuration": {
      "title": "REDdeck",
      "properties": {
        "reddeck.gamePath": {
          "type": "string",
          "default": "",
          "description": "The Cyberpunk 2077 install folder (the one containing bin, archive and r6). Leave it empty to find the game through Steam, GOG or Epic on every start; the status bar and the REDdeck page footer show the folder in use. Set it only for a game those cannot see. The command REDdeck: Pick the game folder sets it for you."
        },
        "reddeck.libraryPath": {
          "type": "string",
          "default": "",
          "description": "Where REDdeck keeps your mods. Empty means %USERPROFILE%\\REDdeck. Put it on the same drive as the game so deploy can use hardlinks instead of copies."
        },
        "reddeck.bridgePath": {
          "type": "string",
          "default": "",
          "description": "Path to REDbridge.exe or its folder. Empty means the copy REDdeck fetched with Get REDbridge, else a REDbridge checkout next to this one, else REDbridge on PATH. With it, REDdeck shows conflicts between resources inside mod archives."
        },
        "reddeck.dotnetRoot": {
          "type": "string",
          "default": "",
          "description": "DOTNET_ROOT for the REDbridge process only. Empty means the per-user .NET 10 runtime in %LOCALAPPDATA%\\Microsoft\\dotnet when there is one, else whatever the machine has. Never set DOTNET_ROOT as a user environment variable: every .NET program then looks only there."
        },
        "reddeck.nexusCheckUpdatesOnStart": {
          "type": "boolean",
          "default": true,
          "description": "Ask Nexus Mods once a day whether the mods with a Nexus id have a newer file. Needs you signed in (REDdeck: Nexus: sign in)."
        },
        "reddeck.nexusClientId": {
          "type": "string",
          "default": "",
          "description": "The OAuth client id Nexus Mods assigned to REDdeck. With it, Nexus: sign in opens the Nexus sign-in page in your browser and comes back on its own; the sign-in renews itself. Empty means the application slug below, or the API Access page and a pasted key."
        },
        "reddeck.nexusApplication": {
          "type": "string",
          "default": "",
          "description": "The application slug Nexus Mods registered for REDdeck's older single sign-on. Used when there is no client id. Empty means sign-in opens the API Access page and asks you to paste the key."
        },
        "reddeck.vortexStagingPath": {
          "type": "string",
          "default": "",
          "description": "Where Vortex keeps its Cyberpunk 2077 mods (Vortex: Settings > Mods > Mod Staging Folder), for Import from Vortex. Empty means REDdeck looks in Vortex's deployment manifest, Vortex's default folder in AppData, and \"Vortex Mods\\cyberpunk2077\" on each drive, and asks when none has mods."
        }
      }
    },
    "colors": [
      {
        "id": "reddeck.accent",
        "description": "Accent for REDdeck icons and the status bar item.",
        "defaults": {
          "dark": "#fcee0a",
          "light": "#8a7a00",
          "highContrast": "#fcee0a",
          "highContrastLight": "#8a7a00"
        }
      }
    ],
    "mcpServerDefinitionProviders": [
      {
        "id": "reddeck.mcp",
        "label": "REDdeck"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "package": "node -e \"require('fs').mkdirSync('dist',{recursive:true})\" && vsce package --no-dependencies --target win32-x64 --readme-path docs/marketplace.md --out dist/",
    "test:ui": "node scripts/ui-test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "7zip-bin": "^5.2.0",
    "vscode-jsonrpc": "^9.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/vscode": "1.80.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "ovsx": "^1.2.0",
    "typescript": "~5.9.3"
  },
  "bin": {
    "reddeck": "bin/reddeck.mjs"
  }
}
