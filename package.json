{
  "name": "reddeck",
  "displayName": "REDdeck",
  "description": "A simple mod manager for Cyberpunk 2077: one list, add, on/off, deploy, remove.",
  "version": "0.6.1",
  "publisher": "edgemodders",
  "license": "MIT",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#08090d",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Edgemodders/REDdeck"
  },
  "engines": {
    "vscode": "^1.80.0",
    "node": ">=20"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "cyberpunk",
    "modding",
    "mod manager",
    "redcode",
    "nexus"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "reddeck",
          "title": "REDdeck",
          "icon": "images/activity.svg"
        }
      ]
    },
    "views": {
      "reddeck": [
        {
          "id": "reddeck.mods",
          "name": "Mods"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "reddeck.mods",
        "contents": "No mods yet.\nAdd a zip from Nexus Mods or a mod folder, turn it on, and deploy. Nothing touches the game until you deploy.\n[Add mod](command:reddeck.addMod)\n[Import from Vortex](command:reddeck.importVortex)",
        "when": "reddeck.empty"
      }
    ],
    "commands": [
      {
        "command": "reddeck.addMod",
        "title": "Add mod",
        "category": "REDdeck",
        "icon": "$(add)"
      },
      {
        "command": "reddeck.details",
        "title": "Details",
        "category": "REDdeck"
      },
      {
        "command": "reddeck.addProject",
        "title": "Add from REDcode project",
        "category": "REDdeck"
      },
      {
        "command": "reddeck.checkConflicts",
        "title": "Check archive conflicts",
        "category": "REDdeck"
      },
      {
        "command": "reddeck.importVortex",
        "title": "Import from Vortex",
        "category": "REDdeck"
      },
      {
        "command": "reddeck.deploy",
        "title": "Deploy",
        "category": "REDdeck",
        "icon": "$(rocket)"
      },
      {
        "command": "reddeck.undo",
        "title": "Undo deploy",
        "category": "REDdeck"
      },
      {
        "command": "reddeck.remove",
        "title": "Remove",
        "category": "REDdeck"
      },
      {
        "command": "reddeck.moveUp",
        "title": "Move up (wins conflicts)",
        "category": "REDdeck",
        "icon": "$(arrow-up)"
      },
      {
        "command": "reddeck.moveDown",
        "title": "Move down",
        "category": "REDdeck",
        "icon": "$(arrow-down)"
      },
      {
        "command": "reddeck.openInExplorer",
        "title": "Reveal in File Explorer",
        "category": "REDdeck"
      },
      {
        "command": "reddeck.openLibrary",
        "title": "Open library folder",
        "category": "REDdeck"
      },
      {
        "command": "reddeck.refresh",
        "title": "Refresh",
        "category": "REDdeck",
        "icon": "$(refresh)"
      },
      {
        "command": "reddeck.showLog",
        "title": "Show log",
        "category": "REDdeck"
      },
      {
        "command": "reddeck.nexusSetKey",
        "title": "Nexus: set API key",
        "category": "REDdeck"
      },
      {
        "command": "reddeck.nexusOpen",
        "title": "Open on Nexus Mods",
        "category": "REDdeck"
      },
      {
        "command": "reddeck.checkUpdates",
        "title": "Nexus: check for updates",
        "category": "REDdeck",
        "icon": "$(cloud-download)"
      },
      {
        "command": "reddeck.nexusAddLink",
        "title": "Nexus: add from a link",
        "category": "REDdeck"
      },
      {
        "command": "reddeck.nexusHandleLinks",
        "title": "Nexus: handle download links (nxm)",
        "category": "REDdeck"
      },
      {
        "command": "reddeck.nexusReleaseLinks",
        "title": "Nexus: stop handling download links",
        "category": "REDdeck"
      },
      {
        "command": "reddeck.saveLoadout",
        "title": "Save loadout",
        "category": "REDdeck"
      },
      {
        "command": "reddeck.loadLoadout",
        "title": "Load loadout",
        "category": "REDdeck"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "reddeck.addMod",
          "when": "view == reddeck.mods",
          "group": "navigation@1"
        },
        {
          "command": "reddeck.deploy",
          "when": "view == reddeck.mods",
          "group": "navigation@2"
        },
        {
          "command": "reddeck.refresh",
          "when": "view == reddeck.mods",
          "group": "navigation@4"
        },
        {
          "command": "reddeck.checkUpdates",
          "when": "view == reddeck.mods",
          "group": "navigation@3"
        },
        {
          "command": "reddeck.checkConflicts",
          "when": "view == reddeck.mods",
          "group": "1_more@0"
        },
        {
          "command": "reddeck.importVortex",
          "when": "view == reddeck.mods",
          "group": "1_more@1"
        },
        {
          "command": "reddeck.undo",
          "when": "view == reddeck.mods && reddeck.deployed",
          "group": "1_more@2"
        },
        {
          "command": "reddeck.openLibrary",
          "when": "view == reddeck.mods",
          "group": "2_folders@1"
        },
        {
          "command": "reddeck.showLog",
          "when": "view == reddeck.mods",
          "group": "2_folders@2"
        },
        {
          "command": "reddeck.nexusAddLink",
          "when": "view == reddeck.mods",
          "group": "1_more@3"
        },
        {
          "command": "reddeck.addProject",
          "when": "view == reddeck.mods",
          "group": "1_more@4"
        },
        {
          "command": "reddeck.saveLoadout",
          "when": "view == reddeck.mods",
          "group": "3_loadouts@1"
        },
        {
          "command": "reddeck.loadLoadout",
          "when": "view == reddeck.mods",
          "group": "3_loadouts@2"
        }
      ],
      "view/item/context": [
        {
          "command": "reddeck.moveUp",
          "when": "view == reddeck.mods && viewItem == mod",
          "group": "inline@1"
        },
        {
          "command": "reddeck.moveDown",
          "when": "view == reddeck.mods && viewItem == mod",
          "group": "inline@2"
        },
        {
          "command": "reddeck.details",
          "when": "view == reddeck.mods && viewItem == mod",
          "group": "0_details@1"
        },
        {
          "command": "reddeck.nexusOpen",
          "when": "view == reddeck.mods && viewItem == mod",
          "group": "1_open@0"
        },
        {
          "command": "reddeck.openInExplorer",
          "when": "view == reddeck.mods && viewItem == mod",
          "group": "1_open@1"
        },
        {
          "command": "reddeck.remove",
          "when": "view == reddeck.mods && viewItem == mod",
          "group": "9_remove@1"
        }
      ],
      "commandPalette": [
        {
          "command": "reddeck.remove",
          "when": "false"
        },
        {
          "command": "reddeck.moveUp",
          "when": "false"
        },
        {
          "command": "reddeck.moveDown",
          "when": "false"
        },
        {
          "command": "reddeck.openInExplorer",
          "when": "false"
        },
        {
          "command": "reddeck.details",
          "when": "false"
        },
        {
          "command": "reddeck.nexusOpen",
          "when": "false"
        }
      ],
      "explorer/context": [
        {
          "command": "reddeck.addProject",
          "when": "resourceExtname == .cpmodproj",
          "group": "reddeck@1"
        }
      ]
    },
    "configuration": {
      "title": "REDdeck",
      "properties": {
        "reddeck.gamePath": {
          "type": "string",
          "default": "C:\\Program Files (x86)\\Steam\\steamapps\\common\\Cyberpunk 2077",
          "description": "The Cyberpunk 2077 install folder (the one containing bin, archive and r6)."
        },
        "reddeck.libraryPath": {
          "type": "string",
          "default": "",
          "description": "Where REDdeck keeps your mods. Empty means %USERPROFILE%\\REDdeck. Put it on the same drive as the game so deploy can use hardlinks instead of copies."
        },
        "reddeck.bridgePath": {
          "type": "string",
          "default": "",
          "description": "Path to REDbridge.exe or its folder. With it, REDdeck shows conflicts between resources inside mod archives. Empty means a REDbridge checkout next to this one, or REDbridge on PATH."
        },
        "reddeck.dotnetRoot": {
          "type": "string",
          "default": "",
          "description": "DOTNET_ROOT for REDbridge, when the .NET 10 runtime is installed per user rather than machine wide."
        },
        "reddeck.nexusCheckUpdatesOnStart": {
          "type": "boolean",
          "default": true,
          "description": "Ask Nexus Mods once a day whether the mods with a Nexus id have a newer file. Needs an API key (REDdeck: Nexus: set API key)."
        }
      }
    },
    "colors": [
      {
        "id": "reddeck.accent",
        "description": "Accent for REDdeck icons and the status bar item.",
        "defaults": {
          "dark": "#fcee0a",
          "light": "#8a7a00",
          "highContrast": "#fcee0a",
          "highContrastLight": "#8a7a00"
        }
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "package": "node -e \"require('fs').mkdirSync('dist',{recursive:true})\" && vsce package --no-dependencies --readme-path docs/marketplace.md --out dist/",
    "test:ui": "node scripts/ui-test.mjs"
  },
  "dependencies": {
    "7zip-bin": "^5.2.0",
    "vscode-jsonrpc": "^9.0.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/vscode": "1.80.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "typescript": "~5.9.3"
  },
  "bin": {
    "reddeck": "bin/reddeck.mjs"
  }
}
